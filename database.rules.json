{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('hostUid').val() === auth.uid : newData.child('hostUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['hostUid', 'status', 'settings'])",
        "status": { ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('rooms/' + $code + '/status').val() === 'waiting')",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()"
        }
      }
    }
  }
}
