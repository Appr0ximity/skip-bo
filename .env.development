# Local development against the Firebase emulators (no real project needed).
# "demo-" project ids only ever talk to the emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-skipbo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-skipbo
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-skipbo-default-rtdb
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
